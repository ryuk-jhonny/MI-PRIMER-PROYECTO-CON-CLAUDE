# Copia este archivo como .env.local y pega los datos de tu app web de Firebase
# (Consola de Firebase → ⚙ Configuración del proyecto → Tus apps → SDK de Firebase → Configuración).
# Paso a paso en FIREBASE.md. Estos valores son públicos: están hechos para ir en la web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para probar en tu computadora con los emuladores de Firebase (npm run emuladores).
# VITE_FIREBASE_EMULATOR=true

# Planificación con IA (opcional). Estas claves SÍ son secretas: van solo aquí y en las
# variables de Vercel, nunca con el prefijo VITE_. Con una de las dos ya funciona.
# GEMINI_API_KEY=
# GROQ_API_KEY=
