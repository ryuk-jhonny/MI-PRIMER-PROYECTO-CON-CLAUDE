{
  "name": "sistema-institucional-ryuk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "vite --mode emulador --port=3000",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-ryuk",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-ryuk \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-ryuk \"playwright test\"",
    "test:todo": "npm run lint && npm test && npm run test:reglas && npm run test:e2e",
    "deploy:reglas": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
